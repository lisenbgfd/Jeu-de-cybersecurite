<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DDoS Defense Simulator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0a0a0a, #1a1a2e);
            color: white;
            font-family: 'Courier New', monospace;
            height: 100vh;
            overflow: hidden;
        }

        .game-container {
            display: grid;
            grid-template-areas: 
                "attack-panel game-area defense-panel"
                "attack-panel status-bar defense-panel"
                "logs logs logs";
            grid-template-columns: 250px 1fr 250px;
            grid-template-rows: 1fr auto 120px;
            height: 100vh;
            gap: 10px;
            padding: 10px;
        }

        .panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 20px;
        }

        .attack-panel {
            grid-area: attack-panel;
            background: linear-gradient(145deg, rgba(255, 0, 0, 0.1), rgba(139, 0, 0, 0.1));
        }

        .defense-panel {
            grid-area: defense-panel;
            background: linear-gradient(145deg, rgba(0, 255, 0, 0.1), rgba(0, 139, 0, 0.1));
        }

        .game-area {
            grid-area: game-area;
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            background: radial-gradient(circle at center, #1a1a2e, #0a0a0a);
        }

        .status-bar {
            grid-area: status-bar;
            display: flex;
            justify-content: space-around;
            align-items: center;
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
        }

        .logs-panel {
            grid-area: logs;
            background: rgba(0, 0, 0, 0.8);
            padding: 15px;
            border-radius: 10px;
            overflow-y: auto;
            max-height: 120px;
        }

        .btn {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-attack {
            background: linear-gradient(45deg, #ff0000, #cc0000);
            color: white;
        }

        .btn-attack:hover {
            background: linear-gradient(45deg, #ff3333, #ff0000);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 0, 0, 0.4);
        }

        .btn-defense {
            background: linear-gradient(45deg, #00aa00, #008800);
            color: white;
        }

        .btn-defense:hover {
            background: linear-gradient(45deg, #00cc00, #00aa00);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 255, 0, 0.4);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .server {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 60px;
            background: linear-gradient(45deg, #00ff00, #00aa00);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.5);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: black;
        }

        .server.under-attack {
            background: linear-gradient(45deg, #ff0000, #cc0000);
            animation: shake 0.5s infinite;
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.8);
        }

        .server.protected {
            background: linear-gradient(45deg, #0088ff, #0066cc);
            box-shadow: 0 0 40px rgba(0, 136, 255, 0.8);
        }

        @keyframes shake {
            0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
            25% { transform: translate(-48%, -52%) rotate(1deg); }
            75% { transform: translate(-52%, -48%) rotate(-1deg); }
        }

        .spawn-point {
            position: absolute;
            width: 15px;
            height: 15px;
            background: radial-gradient(circle, #ff0000, #990000);
            border-radius: 50%;
            opacity: 0.3;
            transition: all 0.3s ease;
        }

        .spawn-point.active {
            opacity: 1;
            animation: pulse 1s infinite;
            box-shadow: 0 0 10px rgba(255, 0, 0, 0.8);
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }

        .packet {
            position: absolute;
            width: 8px;
            height: 8px;
            background: radial-gradient(circle, #ff0000, #cc0000);
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(255, 0, 0, 0.6);
            transition: all 0.1s linear;
        }

        .packet.blocked {
            background: radial-gradient(circle, #666666, #333333);
            box-shadow: 0 0 5px rgba(102, 102, 102, 0.6);
        }

        .health-bar {
            width: 200px;
            height: 20px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .health-fill {
            height: 100%;
            background: linear-gradient(90deg, #ff0000, #ffaa00, #00ff00);
            transition: width 0.5s ease;
            border-radius: 10px;
        }

        .stat {
            text-align: center;
            font-size: 14px;
        }

        .stat-label {
            font-size: 12px;
            opacity: 0.8;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 16px;
            font-weight: bold;
        }

        .log-entry {
            margin: 3px 0;
            padding: 5px;
            border-radius: 3px;
            font-size: 12px;
            animation: slideIn 0.3s ease;
        }

        .log-error {
            background: rgba(255, 0, 0, 0.2);
            border-left: 3px solid #ff0000;
        }

        .log-success {
            background: rgba(0, 255, 0, 0.2);
            border-left: 3px solid #00ff00;
        }

        .log-info {
            background: rgba(0, 136, 255, 0.2);
            border-left: 3px solid #0088ff;
        }

        @keyframes slideIn {
            from { transform: translateX(-100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .defense-system {
            position: absolute;
            opacity: 0;
            transition: all 0.5s ease;
        }

        .defense-system.active {
            opacity: 1;
        }

        .firewall {
            top: 40%;
            left: 35%;
            width: 30%;
            height: 3px;
            background: linear-gradient(90deg, transparent, #0088ff, transparent);
            box-shadow: 0 0 10px rgba(0, 136, 255, 0.8);
        }

        .shield {
            top: 35%;
            left: 35%;
            width: 30%;
            height: 30%;
            border: 3px solid rgba(0, 136, 255, 0.6);
            border-radius: 50%;
            animation: rotate 3s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .panel h3 {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }

        .cost {
            font-size: 12px;
            opacity: 0.8;
            display: block;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <div class="game-container">
        <!-- Panel d'Attaque -->
        <div class="panel attack-panel">
            <h3>🚨 ATTAQUES</h3>
            <button class="btn btn-attack" onclick="startPingFlood()">
                Ping Flood
                <span class="cost">Attaque modérée</span>
            </button>
            <button class="btn btn-attack" onclick="startBotnetAttack()">
                Botnet Attack
                <span class="cost">Attaque massive</span>
            </button>
            <button class="btn btn-attack" onclick="stopAttack()" id="stopBtn" disabled>
                Arrêter Attaque
            </button>
        </div>

        <!-- Zone de Jeu -->
        <div class="game-area" id="gameArea">
            <div class="server" id="server">SERVER</div>
            
            <!-- Spawn Points (positionnés en cercle) -->
            <div class="spawn-point" style="top: 10%; left: 50%;"></div>
            <div class="spawn-point" style="top: 20%; left: 75%;"></div>
            <div class="spawn-point" style="top: 40%; left: 90%;"></div>
            <div class="spawn-point" style="top: 60%; left: 90%;"></div>
            <div class="spawn-point" style="top: 80%; left: 75%;"></div>
            <div class="spawn-point" style="top: 90%; left: 50%;"></div>
            <div class="spawn-point" style="top: 80%; left: 25%;"></div>
            <div class="spawn-point" style="top: 60%; left: 10%;"></div>
            <div class="spawn-point" style="top: 40%; left: 10%;"></div>
            <div class="spawn-point" style="top: 20%; left: 25%;"></div>

            <!-- Systèmes de Défense -->
            <div class="defense-system firewall" id="firewall"></div>
            <div class="defense-system shield" id="shield"></div>
        </div>

        <!-- Panel de Défense -->
        <div class="panel defense-panel">
            <h3>🛡️ DÉFENSES</h3>
            <button class="btn btn-defense" onclick="deployFirewall()" id="firewallBtn">
                Firewall ICMP
                <span class="cost">500€ - Bloque 40%</span>
            </button>
            <button class="btn btn-defense" onclick="deployReverseProxy()" id="proxyBtn">
                Reverse Proxy
                <span class="cost">1500€ - Réduit 60%</span>
            </button>
            <button class="btn btn-defense" onclick="deployRateLimiting()" id="rateLimitBtn">
                Rate Limiting
                <span class="cost">800€ - Réduit 30%</span>
            </button>
            <button class="btn btn-defense" onclick="upgradeInfrastructure()" id="infraBtn">
                Infrastructure+
                <span class="cost">3000€ - Réduit 70%</span>
            </button>
        </div>

        <!-- Barre de Statut -->
        <div class="status-bar">
            <div class="stat">
                <div class="stat-label">Santé Serveur</div>
                <div class="health-bar">
                    <div class="health-fill" id="healthFill" style="width: 100%;"></div>
                </div>
                <div class="stat-value" id="healthText">100%</div>
            </div>
            <div class="stat">
                <div class="stat-label">Budget</div>
                <div class="stat-value" id="budgetText">5000€</div>
            </div>
            <div class="stat">
                <div class="stat-label">Trafic</div>
                <div class="stat-value" id="trafficText">Normal: 45 req/s</div>
            </div>
            <div class="stat">
                <div class="stat-label">Ventes Perdues</div>
                <div class="stat-value" id="salesText">0€</div>
            </div>
        </div>

        <!-- Panel de Logs -->
        <div class="panel logs-panel" id="logsPanel">
            <div id="logs">
                <div class="log-entry log-info">🔧 Système initialisé - Serveur opérationnel</div>
                <div class="log-entry log-info">📊 Surveillance du trafic activée</div>
            </div>
        </div>
    </div>

    <script>
        // État du jeu
        let gameState = {
            serverHealth: 100,
            budget: 5000,
            lostSales: 0,
            currentTraffic: 45,
            isUnderAttack: false,
            defenses: {
                firewall: { active: false, cost: 500, damageReduction: 0.4, blockChance: 0.4 },
                reverseProxy: { active: false, cost: 1500, damageReduction: 0.6, blockChance: 0.3 },
                rateLimiting: { active: false, cost: 800, damageReduction: 0.3, blockChance: 0.2 },
                infrastructure: { active: false, cost: 3000, damageReduction: 0.7, blockChance: 0 }
            }
        };

        let attackInterval = null;
        let normalTrafficInterval = null;

        // Initialisation
        function init() {
            updateUI();
            startNormalTraffic();
        }

        // Simulation du trafic normal
        function startNormalTraffic() {
            normalTrafficInterval = setInterval(() => {
                if (!gameState.isUnderAttack) {
                    gameState.currentTraffic = 45 + Math.random() * 20;
                    updateUI();
                }
            }, 1000);
        }

        // Mise à jour de l'interface
        function updateUI() {
            document.getElementById('healthText').textContent = Math.round(gameState.serverHealth) + '%';
            document.getElementById('healthFill').style.width = gameState.serverHealth + '%';
            document.getElementById('budgetText').textContent = gameState.budget + '€';
            document.getElementById('salesText').textContent = gameState.lostSales + '€';
            
            const trafficStatus = gameState.isUnderAttack ? 'ATTAQUE' : 'Normal';
            document.getElementById('trafficText').textContent = `${trafficStatus}: ${Math.round(gameState.currentTraffic)} req/s`;

            // Mise à jour des boutons de défense
            updateDefenseButtons();
        }

        function updateDefenseButtons() {
            const buttons = [
                { id: 'firewallBtn', defense: 'firewall' },
                { id: 'proxyBtn', defense: 'reverseProxy' },
                { id: 'rateLimitBtn', defense: 'rateLimiting' },
                { id: 'infraBtn', defense: 'infrastructure' }
            ];

            buttons.forEach(btn => {
                const button = document.getElementById(btn.id);
                const defense = gameState.defenses[btn.defense];
                
                if (defense.active) {
                    button.disabled = true;
                    button.style.opacity = '0.5';
                    button.innerHTML = button.innerHTML.replace('🛡️', '✅');
                } else if (gameState.budget < defense.cost) {
                    button.disabled = true;
                    button.style.opacity = '0.5';
                } else {
                    button.disabled = false;
                    button.style.opacity = '1';
                }
            });
        }

        // Système de logs
        function addLog(message, type = 'info') {
            const logsContainer = document.getElementById('logs');
            const logEntry = document.createElement('div');
            logEntry.className = `log-entry log-${type}`;
            logEntry.textContent = message;
            
            logsContainer.appendChild(logEntry);
            logsContainer.scrollTop = logsContainer.scrollHeight;

            // Limiter à 10 entrées
            while (logsContainer.children.length > 10) {
                logsContainer.removeChild(logsContainer.firstChild);
            }
        }

        // Attaques
        function startPingFlood() {
            if (gameState.isUnderAttack) return;
            
            gameState.isUnderAttack = true;
            document.getElementById('server').classList.add('under-attack');
            document.getElementById('stopBtn').disabled = false;
            
            // Activer 4 spawn points
            const spawnPoints = document.querySelectorAll('.spawn-point');
            for (let i = 0; i < 4; i++) {
                spawnPoints[i].classList.add('active');
            }

            addLog('⚠️ ALERTE: Attaque Ping Flood détectée!', 'error');

            attackInterval = setInterval(() => {
                gameState.currentTraffic = 1000 + Math.random() * 2000;
                spawnPackets(30, 4);
                
                let damage = 2;
                damage = calculateDamageReduction(damage);
                takeDamage(damage);
                
                updateUI();
            }, 500);
        }

        function startBotnetAttack() {
            if (gameState.isUnderAttack) return;
            
            gameState.isUnderAttack = true;
            document.getElementById('server').classList.add('under-attack');
            document.getElementById('stopBtn').disabled = false;
            
            // Activer tous les spawn points
            const spawnPoints = document.querySelectorAll('.spawn-point');
            spawnPoints.forEach(sp => sp.classList.add('active'));

            addLog('🚨 ALERTE CRITIQUE: Attaque Botnet massive!', 'error');

            attackInterval = setInterval(() => {
                gameState.currentTraffic = 5000 + Math.random() * 10000;
                spawnPackets(80, 10);
                
                let damage = 5;
                damage = calculateDamageReduction(damage);
                takeDamage(damage);
                
                updateUI();
            }, 300);
        }

        function stopAttack() {
            if (!gameState.isUnderAttack) return;
            
            gameState.isUnderAttack = false;
            document.getElementById('server').classList.remove('under-attack');
            document.getElementById('stopBtn').disabled = true;
            
            // Désactiver tous les spawn points
            const spawnPoints = document.querySelectorAll('.spawn-point');
            spawnPoints.forEach(sp => sp.classList.remove('active'));

            if (attackInterval) {
                clearInterval(attackInterval);
                attackInterval = null;
            }

            addLog('✅ Attaque terminée - Retour à la normale', 'success');
            updateUI();
        }

        // Spawn des paquets
        function spawnPackets(count, activeSpawnPoints) {
            const gameArea = document.getElementById('gameArea');
            const spawnPoints = document.querySelectorAll('.spawn-point');
            const server = document.getElementById('server');
            const serverRect = server.getBoundingClientRect();
            const gameAreaRect = gameArea.getBoundingClientRect();

            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    const spawnIndex = Math.floor(Math.random() * activeSpawnPoints);
                    const spawnPoint = spawnPoints[spawnIndex];
                    const spawnRect = spawnPoint.getBoundingClientRect();

                    const packet = document.createElement('div');
                    packet.className = 'packet';
                    
                    const isBlocked = shouldBlockPacket();
                    if (isBlocked) {
                        packet.classList.add('blocked');
                    }

                    // Position initiale relative au gameArea
                    const startX = spawnRect.left - gameAreaRect.left;
                    const startY = spawnRect.top - gameAreaRect.top;
                    
                    packet.style.left = startX + 'px';
                    packet.style.top = startY + 'px';

                    gameArea.appendChild(packet);

                    // Animation vers le serveur
                    const targetX = (serverRect.left - gameAreaRect.left) + server.offsetWidth / 2;
                    const targetY = (serverRect.top - gameAreaRect.top) + server.offsetHeight / 2;

                    const duration = 1000 + Math.random() * 500;
                    
                    packet.animate([
                        { left: startX + 'px', top: startY + 'px' },
                        { left: targetX + 'px', top: targetY + 'px' }
                    ], {
                        duration: duration,
                        easing: 'ease-in'
                    }).addEventListener('finish', () => {
                        if (!isBlocked) {
                            createImpactEffect(targetX, targetY);
                        }
                        packet.remove();
                    });

                }, Math.random() * 200);
            }
        }

        // Effet d'impact
        function createImpactEffect(x, y) {
            const gameArea = document.getElementById('gameArea');
            const impact = document.createElement('div');
            impact.style.position = 'absolute';
            impact.style.left = x + 'px';
            impact.style.top = y + 'px';
            impact.style.width = '20px';
            impact.style.height = '20px';
            impact.style.background = 'radial-gradient(circle, #ff6600, transparent)';
            impact.style.borderRadius = '50%';
            impact.style.pointerEvents = 'none';
            
            gameArea.appendChild(impact);

            impact.animate([
                { transform: 'scale(0)', opacity: 1 },
                { transform: 'scale(2)', opacity: 0 }
            ], {
                duration: 300,
                easing: 'ease-out'
            }).addEventListener('finish', () => {
                impact.remove();
            });
        }

        // Calcul des dégâts avec défenses
        function calculateDamageReduction(baseDamage) {
            let reduction = 1;
            
            Object.values(gameState.defenses).forEach(defense => {
                if (defense.active) {
                    reduction *= (1 - defense.damageReduction);
                }
            });
            
            return baseDamage * reduction;
        }

        // Vérification du blocage des paquets
        function shouldBlockPacket() {
            let blockChance = 0;
            
            Object.values(gameState.defenses).forEach(defense => {
                if (defense.active) {
                    blockChance += defense.blockChance;
                }
            });
            
            return Math.random() < blockChance;
        }

        // Dégâts sur le serveur
        function takeDamage(damage) {
            gameState.serverHealth = Math.max(0, gameState.serverHealth - damage);
            
            if (gameState.serverHealth < 50) {
                gameState.lostSales += Math.round(damage * 100);
            }
            
            if (gameState.serverHealth <= 0) {
                gameOver();
            }
        }

        // Dépenser le budget
        function spendBudget(cost) {
            if (gameState.budget >= cost) {
                gameState.budget -= cost;
                updateUI();
                return true;
            }
            return false;
        }

        // Déploiement des défenses
        function deployFirewall() {
            if (spendBudget(gameState.defenses.firewall.cost) && !gameState.defenses.firewall.active) {
                gameState.defenses.firewall.active = true;
                document.getElementById('firewall').classList.add('active');
                addLog('🛡️ Firewall ICMP déployé', 'success');
            }
        }

        function deployReverseProxy() {
            if (spendBudget(gameState.defenses.reverseProxy.cost) && !gameState.defenses.reverseProxy.active) {
                gameState.defenses.reverseProxy.active = true;
                document.getElementById('shield').classList.add('active');
                document.getElementById('server').classList.add('protected');
                addLog('🔄 Reverse Proxy activé', 'success');
            }
        }

        function deployRateLimiting() {
            if (spendBudget(gameState.defenses.rateLimiting.cost) && !gameState.defenses.rateLimiting.active) {
                gameState.defenses.rateLimiting.active = true;
                addLog('⏱️ Rate Limiting activé', 'success');
            }
        }

        function upgradeInfrastructure() {
            if (spendBudget(gameState.defenses.infrastructure.cost) && !gameState.defenses.infrastructure.active) {
                gameState.defenses.infrastructure.active = true;
                gameState.serverHealth = Math.min(100, gameState.serverHealth + 30);
                addLog('🏗️ Infrastructure renforcée', 'success');
            }
        }

        // Game Over
        function gameOver() {
            stopAttack();
            addLog('💀 GAME OVER - Serveur détruit!', 'error');
            alert(`Game Over!\n\nVentes perdues: ${gameState.lostSales}€\nBudget restant: ${gameState.budget}€`);
            
            // Reset
            gameState.serverHealth = 100;
            gameState.budget = 5000;
            gameState.lostSales = 0;
            gameState.currentTraffic = 45;
            
            // Reset defenses
            Object.keys(gameState.defenses).forEach(key => {
                gameState.defenses[key].active = false;
            });
            
            document.getElementById('server').classList.remove('protected');
            document.querySelectorAll('.defense-system').forEach(el => el.classList.remove('active'));
            
            updateUI();
            addLog('🔄 Système redémarré', 'info');
        }

        // Démarrage du jeu
        init();
    </script>
</body>
</html>


