using UnityEngine;
using UnityEngine.UI;
using System.Collections;

public class GameManager : MonoBehaviour
{
    [Header("Server Status")]
    public float serverHealth = 100f;
    public float maxHealth = 100f;
    public int budget = 5000;
    public int lostSales = 0;
    
    [Header("References")]
    public GameObject serverObject;
    public Slider healthBar;
    public Text healthText;
    public Text budgetText;
    public Text salesText;
    public Text trafficText;
    
    [Header("Attack State")]
    public bool isUnderAttack = false;
    public float currentTraffic = 45f;
    
    public static GameManager Instance;
    
    void Awake()
    {
        Instance = this;
    }
    
    void Start()
    {
        UpdateUI();
        StartCoroutine(NormalTrafficSimulation());
    }
    
    IEnumerator NormalTrafficSimulation()
    {
        while (true)
        {
            if (!isUnderAttack)
            {
                currentTraffic = 45f + Random.Range(0f, 20f);
                UpdateUI();
            }
            yield return new WaitForSeconds(1f);
        }
    }
    
    public void TakeDamage(float damage)
    {
        serverHealth = Mathf.Max(0, serverHealth - damage);
        
        if (serverHealth < 50f)
        {
            lostSales += Mathf.RoundToInt(damage * 100);
        }
        
        UpdateUI();
        
        if (serverHealth <= 0)
        {
            GameOver();
        }
    }
    
    public bool SpendBudget(int cost)
    {
        if (budget >= cost)
        {
            budget -= cost;
            UpdateUI();
            return true;
        }
        return false;
    }
    
    void UpdateUI()
    {
        healthBar.value = serverHealth / maxHealth;
        healthText.text = $"{Mathf.RoundToInt(serverHealth)}%";
        budgetText.text = $"{budget}€";
        salesText.text = $"{lostSales}€";
        
        string trafficStatus = isUnderAttack ? "ATTAQUE" : "Normal";
        trafficText.text = $"{trafficStatus}: {Mathf.RoundToInt(currentTraffic)} req/s";
    }
    
    void GameOver()
    {
        Debug.Log("GAME OVER - Server destroyed!");
        // Afficher écran de fin
    }
}

