using UnityEngine;
using System.Collections;
using System.Collections.Generic;

public class AttackManager : MonoBehaviour
{
    [Header("Attack Settings")]
    public GameObject packetPrefab;
    public Transform[] spawnPoints;
    public Transform serverTarget;
    
    [Header("Visual Effects")]
    public ParticleSystem attackParticles;
    public Material attackMaterial;
    public AudioSource attackSound;
    
    private Coroutine currentAttack;
    private bool[] activeSpawnPoints;
    
    void Start()
    {
        activeSpawnPoints = new bool[spawnPoints.Length];
    }
    
    public void StartPingFlood()
    {
        if (GameManager.Instance.isUnderAttack) return;
        
        GameManager.Instance.isUnderAttack = true;
        LogManager.Instance.AddLog("⚠️ ALERTE: Attaque Ping Flood détectée!", LogType.Error);
        
        // Activer 4 spawn points
        for (int i = 0; i < 4 && i < spawnPoints.Length; i++)
        {
            activeSpawnPoints[i] = true;
            spawnPoints[i].gameObject.SetActive(true);
        }
        
        currentAttack = StartCoroutine(PingFloodAttack());
        
        // Effets visuels sur le serveur
        ServerController.Instance.SetAttackState(true);
    }
    
    public void StartBotnetAttack()
    {
        if (GameManager.Instance.isUnderAttack) return;
        
        GameManager.Instance.isUnderAttack = true;
        LogManager.Instance.AddLog("🚨 ALERTE CRITIQUE: Attaque Botnet massive!", LogType.Error);
        
        // Activer tous les spawn points
        for (int i = 0; i < spawnPoints.Length; i++)
        {
            activeSpawnPoints[i] = true;
            spawnPoints[i].gameObject.SetActive(true);
        }
        
        currentAttack = StartCoroutine(BotnetAttack());
        ServerController.Instance.SetAttackState(true);
    }
    
    IEnumerator PingFloodAttack()
    {
        while (GameManager.Instance.isUnderAttack)
        {
            SpawnPackets(50);
            GameManager.Instance.currentTraffic = 1000f + Random.Range(0f, 2000f);
            
            float damage = 2f;
            damage = DefenseManager.Instance.CalculateDamageReduction(damage);
            GameManager.Instance.TakeDamage(damage);
            
            yield return new WaitForSeconds(0.5f);
        }
    }
    
    IEnumerator BotnetAttack()
    {
        while (GameManager.Instance.isUnderAttack)
        {
            SpawnPackets(200);
            GameManager.Instance.currentTraffic = 5000f + Random.Range(0f, 10000f);
            
            float damage = 5f;
            damage = DefenseManager.Instance.CalculateDamageReduction(damage);
            GameManager.Instance.TakeDamage(damage);
            
            yield return new WaitForSeconds(0.3f);
        }
    }
    
    void SpawnPackets(int count)
    {
        for (int i = 0; i < count; i++)
        {
            StartCoroutine(SpawnSinglePacket(Random.Range(0f, 0.2f)));
        }
    }
    
    IEnumerator SpawnSinglePacket(float delay)
    {
        yield return new WaitForSeconds(delay);
        
        List<Transform> activeSpawns = new List<Transform>();
        for (int i = 0; i < spawnPoints.Length; i++)
        {
            if (activeSpawnPoints[i])
                activeSpawns.Add(spawnPoints[i]);
        }
        
        if (activeSpawns.Count == 0) yield break;
        
        Transform spawnPoint = activeSpawns[Random.Range(0, activeSpawns.Count)];
        GameObject packet = Instantiate(packetPrefab, spawnPoint.position, Quaternion.identity);
        
        PacketController packetCtrl = packet.GetComponent<PacketController>();
        bool isBlocked = DefenseManager.Instance.ShouldBlockPacket();
        
        packetCtrl.Initialize(serverTarget.position, isBlocked);
    }
    
    public void StopAttack()
    {
        if (!GameManager.Instance.isUnderAttack) return;
        
        GameManager.Instance.isUnderAttack = false;
        
        if (currentAttack != null)
        {
            StopCoroutine(currentAttack);
        }
        
        // Désactiver tous les spawn points
        for (int i = 0; i < spawnPoints.Length; i++)
        {
            activeSpawnPoints[i] = false;
            spawnPoints[i].gameObject.SetActive(false);
        }
        
        ServerController.Instance.SetAttackState(false);
        LogManager.Instance.AddLog("✅ Attaque terminée - Retour à la normale", LogType.Success);
    }
}

