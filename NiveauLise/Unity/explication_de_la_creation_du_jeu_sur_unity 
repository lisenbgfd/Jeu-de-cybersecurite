using UnityEngine;

public class DefenseManager : MonoBehaviour
{
    [System.Serializable]
    public class DefenseSystem
    {
        public bool isActive;
        public int cost;
        public float damageReduction;
        public float blockChance;
        public GameObject visualObject;
    }
    
    [Header("Defense Systems")]
    public DefenseSystem firewall = new DefenseSystem { cost = 500, damageReduction = 0.4f, blockChance = 0.4f };
    public DefenseSystem reverseProxy = new DefenseSystem { cost = 1500, damageReduction = 0.6f, blockChance = 0.3f };
    public DefenseSystem rateLimiting = new DefenseSystem { cost = 800, damageReduction = 0.3f, blockChance = 0.2f };
    public DefenseSystem robustInfra = new DefenseSystem { cost = 3000, damageReduction = 0.7f, blockChance = 0f };
    
    public static DefenseManager Instance;
    
    void Awake()
    {
        Instance = this;
    }
    
    public void DeployFirewall()
    {
        if (GameManager.Instance.SpendBudget(firewall.cost) && !firewall.isActive)
        {
            firewall.isActive = true;
            firewall.visualObject.SetActive(true);
            LogManager.Instance.AddLog("🛡️ Firewall ICMP déployé", LogType.Success);
        }
    }
    
    public void DeployReverseProxy()
    {
        if (GameManager.Instance.SpendBudget(reverseProxy.cost) && !reverseProxy.isActive)
        {
            reverseProxy.isActive = true;
            reverseProxy.visualObject.SetActive(true);
            ServerController.Instance.SetProtectedState(true);
            LogManager.Instance.AddLog("🔄 Reverse Proxy activé", LogType.Success);
        }
    }
    
    public void DeployRateLimiting()
    {
        if (GameManager.Instance.SpendBudget(rateLimiting.cost) && !rateLimiting.isActive)
        {
            rateLimiting.isActive = true;
            rateLimiting.visualObject.SetActive(true);
            LogManager.Instance.AddLog("⏱️ Rate Limiting activé", LogType.Success);
        }
    }
    
    public void UpgradeInfrastructure()
    {
        if (GameManager.Instance.SpendBudget(robustInfra.cost) && !robustInfra.isActive)
        {
            robustInfra.isActive = true;
            robustInfra.visualObject.SetActive(true);
            GameManager.Instance.serverHealth = Mathf.Min(100f, GameManager.Instance.serverHealth + 30f);
            LogManager.Instance.AddLog("🏗️ Infrastructure renforcée", LogType.Success);
        }
    }
    
    public float CalculateDamageReduction(float baseDamage)
    {
        float reduction = 1f;
        
        if (firewall.isActive) reduction *= (1f - firewall.damageReduction);
        if (reverseProxy.isActive) reduction *= (1f - reverseProxy.damageReduction);
        if (rateLimiting.isActive) reduction *= (1f - rateLimiting.damageReduction);
        if (robustInfra.isActive) reduction *= (1f - robustInfra.damageReduction);
        
        return baseDamage * reduction;
    }
    
    public bool ShouldBlockPacket()
    {
        float blockChance = 0f;
        
        if (firewall.isActive) blockChance += firewall.blockChance;
        if (reverseProxy.isActive) blockChance += reverseProxy.blockChance;
        if (rateLimiting.isActive) blockChance += rateLimiting.blockChance;
        
        return Random.Range(0f, 1f) < blockChance;
    }
}

D. PacketController.cs
using UnityEngine;

public class PacketController : MonoBehaviour
{
    [Header("Movement")]
    public float speed = 10f;
    public AnimationCurve movementCurve = AnimationCurve.EaseInOut(0, 0, 1, 1);
    
    [Header("Visual")]
    public Material normalMaterial;
    public Material blockedMaterial;
    public ParticleSystem trailEffect;
    
    private Vector3 targetPosition;
    private Vector3 startPosition;
    private bool isBlocked;
    private float journeyTime = 0f;
    private float journeyLength;
    
    public void Initialize(Vector3 target, bool blocked)
    {
        targetPosition = target;
        startPosition = transform.position;
        isBlocked = blocked;
        journeyLength = Vector3.Distance(startPosition, targetPosition);
        
        // Appliquer le matériau approprié
        GetComponent<Renderer>().material = blocked ? blockedMaterial : normalMaterial;
        
        // Configurer les effets de particules
        if (trailEffect != null)
        {
            var main = trailEffect.main;
            main.startColor = blocked ? Color.gray : Color.red;
        }
    }
    
    void Update()
    {
        journeyTime += Time.deltaTime * speed;
        float fractionOfJourney = journeyTime / journeyLength;
        
        if (fractionOfJourney >= 1f)
        {
            ReachTarget();
            return;
        }
        
        // Mouvement avec courbe d'animation
        float curveValue = movementCurve.Evaluate(fractionOfJourney);
        transform.position = Vector3.Lerp(startPosition, targetPosition, curveValue);
        
        // Rotation vers la cible
        Vector3 direction = (targetPosition - transform.position).normalized;
        if (direction != Vector3.zero)
        {
            transform.rotation = Quaternion.LookRotation(direction);
        }
    }
    
    void ReachTarget()
    {
        if (!isBlocked)
        {
            // Effet d'impact sur le serveur
            ServerController.Instance.OnPacketHit();
        }
        
        Destroy(gameObject);
    }
}

E. ServerController.cs
using UnityEngine;

public class ServerController : MonoBehaviour
{
    [Header("Visual States")]
    public Material normalMaterial;
    public Material attackedMaterial;
    public Material protectedMaterial;
    
    [Header("Effects")]
    public ParticleSystem impactEffect;
    public ParticleSystem protectionShield;
    public AudioSource impactSound;
    
    [Header("Animation")]
    public float shakeIntensity = 0.1f;
    
    private Vector3 originalPosition;
    private bool isUnderAttack;
    private bool isProtected;
    private Renderer serverRenderer;
    
    public static ServerController Instance;
    
    void Awake()
    {
        Instance = this;
        originalPosition = transform.position;
        serverRenderer = GetComponent<Renderer>();
    }
    
    public void SetAttackState(bool underAttack)
    {
        isUnderAttack = underAttack;
        UpdateVisualState();
        
        if (underAttack)
        {
            InvokeRepeating(nameof(ShakeServer), 0f, 0.1f);
        }
        else
        {
            CancelInvoke(nameof(ShakeServer));
            transform.position = originalPosition;
        }
    }
    
    public void SetProtectedState(bool protected)
    {
        isProtected = protected;
        if (protectionShield != null)
        {
            protectionShield.gameObject.SetActive(protected);
        }
        UpdateVisualState();
    }
    
    void UpdateVisualState()
    {
        if (isProtected)
        {
            serverRenderer.material = protectedMaterial;
        }
        else if (isUnderAttack)
        {
            serverRenderer.material = attackedMaterial;
        }
        else
        {
            serverRenderer.material = normalMaterial;
        }
    }
    
    void ShakeServer()
    {
        if (!isUnderAttack) return;
        
        Vector3 shakeOffset = Random.insideUnitSphere * shakeIntensity;
        shakeOffset.y = 0; // Garder sur le même plan Y
        transform.position = originalPosition + shakeOffset;
    }
    
    public void OnPacketHit()
    {
        if (impactEffect != null)
        {
            impactEffect.Play();
        }
        
        if (impactSound != null)
        {
            impactSound.Play();
        }
    }
}

